# Frontend environment variables

# Backend API URL (your FastAPI server)
# For local development: http://localhost:8000
# For production: your deployed backend URL
VITE_API_URL=http://localhost:8000

# Configure this in the backend environment only (never expose it in Vite/client code).
SCAM_NUMBER_BLOCKLIST=

# Backend phone reputation provider (set these in the backend deployment, not the browser)
SERPER_API_KEY=
# Or use Google Custom Search:
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
