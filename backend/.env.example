# Groq API key — backend only; never put this in frontend/VITE_* variables.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
HOST=0.0.0.0
PORT=8000
# Use your Vercel frontend URL in production.
CORS_ORIGINS=*

# Optional comma-separated exact scam numbers in E.164 form, e.g. +923001234567
SCAM_NUMBER_BLOCKLIST=

# Live phone-number reputation lookup (choose one provider)
# Recommended: https://serper.dev/ (Google Search results API)
SERPER_API_KEY=
# Alternative: Google Programmable Search / Custom Search JSON API
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
