# === AI ScamShield Backend Configuration ===

# Groq API Key (required for AI analysis)
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Text analysis model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Vision/image analysis model (default: qwen/qwen3.6-27b)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Backend server settings
HOST=0.0.0.0
PORT=8000

# CORS - set to your frontend URL in production
# For local development, * is fine
CORS_ORIGINS=*
